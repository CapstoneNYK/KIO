FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# STT (faster-whisper) - 필요 시에만 조정, 비워두면 기본값(small/int8/cpu) 사용
# GPU가 있다면 WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16 으로 바꾸면 훨씬 빠름
WHISPER_MODEL_SIZE=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_CPU_THREADS=0
WHISPER_BEAM_SIZE=1

# LLM (자체 호스팅, Ollama) - 사전에 Ollama 설치(https://ollama.com) 후
# `ollama pull qwen2.5:7b-instruct` 실행 필요. 저사양 PC는 qwen2.5:3b-instruct 등으로 변경
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# 의도 분류(단순 6지선다)만 더 가벼운 모델로 처리해 속도 개선. 미설정 시 OLLAMA_MODEL과 동일 모델 사용
# 사용하려면 먼저 `ollama pull qwen2.5:3b-instruct` 필요
# OLLAMA_INTENT_MODEL=qwen2.5:3b-instruct

# 관리자 로그인 (비밀번호는 bcrypt 해시로 저장, 최초 부트스트랩 계정용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
# 회원가입 시 필요한 코드 (실제 관리자에게만 공유)
ADMIN_SIGNUP_CODE=

# 음성 안내(TTS) - 비워두면 기본값(ko-KR-SunHiNeural, -8%) 사용
TTS_VOICE=ko-KR-SunHiNeural
TTS_RATE=-8%
